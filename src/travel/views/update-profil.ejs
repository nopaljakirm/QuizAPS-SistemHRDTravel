<%- include('../../views/partials/header', { pageTitle: 'Update Profil' }) %>

<div class="page-header">
  <h1 class="h3">Perbarui Data Profil</h1>
  <p class="text-muted mb-0">Lengkapi data profil Anda sebagai member frequent traveller.</p>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (berhasil) { %>
  <div class="alert alert-success">Profil berhasil diperbarui. Status: <strong><%= profil.status_kelengkapan %></strong></div>
<% } %>

<div class="card">
  <div class="card-body">
    <form method="POST" action="/travel/update-profil">
      <div class="mb-3">
        <label class="form-label">Pilih Akun Member</label>
        <select name="penggunaId" class="form-select" required>
          <option value="" disabled selected>-- Pilih nama --</option>
          <% daftarPengguna.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= (pengguna && pengguna.id === p.id) ? 'selected' : '' %>>
              <%= p.nama %> (<%= p.email %>)
            </option>
          <% }); %>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Nomor Identitas (KTP/Paspor)</label>
        <input type="text" class="form-control" name="nomorIdentitas" placeholder="Contoh: 3578xxxxxxxxxxxx" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Nomor Telepon</label>
        <input type="text" class="form-control" name="nomorTelepon" placeholder="Contoh: 081234567890" required>
      </div>
      <button type="submit" class="btn btn-primary">Simpan Profil</button>
    </form>
  </div>
</div>

<%- include('../../views/partials/footer') %>
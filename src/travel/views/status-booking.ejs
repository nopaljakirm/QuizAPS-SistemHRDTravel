<%- include('../../views/partials/header', { pageTitle: 'Status Booking' }) %>

<div class="page-header">
  <h1 class="h3">Status Booking</h1>
  <p class="text-muted mb-0">Periksa dan filter status seluruh booking tiket.</p>
</div>

<div class="mb-3">
  <a href="/travel/status-booking" class="btn btn-sm <%= !filterAktif ? 'btn-primary' : 'btn-outline-primary' %>">Semua</a>
  <a href="/travel/status-booking?filter=confirmed" class="btn btn-sm <%= filterAktif === 'confirmed' ? 'btn-primary' : 'btn-outline-primary' %>">Confirmed</a>
  <a href="/travel/status-booking?filter=booked" class="btn btn-sm <%= filterAktif === 'booked' ? 'btn-primary' : 'btn-outline-primary' %>">Booked</a>
  <a href="/travel/status-booking?filter=waiting_payment" class="btn btn-sm <%= filterAktif === 'waiting_payment' ? 'btn-primary' : 'btn-outline-primary' %>">Waiting Payment</a>
  <a href="/travel/status-booking?filter=dibatalkan" class="btn btn-sm <%= filterAktif === 'dibatalkan' ? 'btn-primary' : 'btn-outline-primary' %>">Dibatalkan</a>
</div>

<% if (data && data.length > 0) { %>
  <div class="card">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr><th>Kode Booking</th><th>No. Penerbangan</th><th>Rute</th><th>Status</th><th>E-tiket</th></tr>
      </thead>
      <tbody>
        <% data.forEach(function(item) { %>
          <tr>
            <td><%= item.kode_booking_reference %></td>
            <td><%= item.nomor_penerbangan %></td>
            <td><%= item.kota_asal %> &rarr; <%= item.kota_tujuan %></td>
            <td><span class="badge text-bg-secondary"><%= item.status_booking %></span></td>
            <td><%= item.etiket_terkirim ? 'Ya' : 'Belum' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="alert alert-info">Belum ada data booking.</div>
<% } %>

<%- include('../../views/partials/footer') %>
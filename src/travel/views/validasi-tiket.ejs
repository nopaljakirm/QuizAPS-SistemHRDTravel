<%- include('../../views/partials/header', { pageTitle: 'Validasi Tiket' }) %>

<div class="page-header">
  <h1 class="h3">Validasi Tiket</h1>
  <p class="text-muted mb-0">Pilih akun dan tiket yang ingin divalidasi.</p>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (hasil && hasil.status === 'profil_tidak_lengkap') { %>
  <div class="alert alert-warning">
    Profil Anda belum lengkap, tiket <strong><%= hasil.kodeBooking %></strong> belum bisa divalidasi.
    <a href="/travel/update-profil?penggunaId=<%= pengguna.id %>" class="alert-link">Lengkapi profil dulu &rarr;</a>
  </div>
<% } %>

<% if (hasil && hasil.status === 'sukses') { %>
  <div class="alert alert-success">Tiket <strong><%= hasil.kodeBooking %></strong> berhasil divalidasi.</div>
<% } %>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/travel/validasi-tiket" class="row g-3 align-items-end">
      <div class="col-md-10">
        <label class="form-label">Pilih Akun Member</label>
        <select name="penggunaId" class="form-select" onchange="this.form.submit()">
          <option value="" disabled <%= !pengguna ? 'selected' : '' %>>-- Pilih nama --</option>
          <% daftarPengguna.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= (pengguna && pengguna.id === p.id) ? 'selected' : '' %>>
              <%= p.nama %> (<%= p.email %>)
            </option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-2">
        <noscript><button type="submit" class="btn btn-secondary w-100">Tampilkan</button></noscript>
      </div>
    </form>
  </div>
</div>

<% if (pengguna) { %>
  <div class="card">
    <div class="card-body">
      <% if (daftarTiket.length === 0) { %>
        <p class="text-muted mb-0">Belum ada tiket atas nama <%= pengguna.nama %> (<%= pengguna.email %>).</p>
      <% } else { %>
        <form method="POST" action="/travel/validasi-tiket">
          <input type="hidden" name="penggunaId" value="<%= pengguna.id %>">
          <div class="mb-3">
            <label class="form-label">Pilih Tiket</label>
            <select name="kodeBooking" class="form-select" required>
              <option value="" disabled selected>-- Pilih kode booking --</option>
              <% daftarTiket.forEach(function(t) { %>
                <% if (t.status_booking !== 'dibatalkan') { %>
                  <option value="<%= t.kode_booking_reference %>">
                    <%= t.kode_booking_reference %> &mdash; <%= t.nomor_penerbangan %> (<%= t.kota_asal %> &rarr; <%= t.kota_tujuan %>)
                  </option>
                <% } %>
              <% }); %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary">Validasi Tiket</button>
        </form>
      <% } %>
    </div>
  </div>
<% } %>

<%- include('../../views/partials/footer') %>
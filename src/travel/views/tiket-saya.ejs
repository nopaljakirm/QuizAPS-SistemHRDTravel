<%- include('../../views/partials/header', { pageTitle: 'Tiket Saya' }) %>

<div class="page-header">
  <h1 class="h3">Tiket Saya</h1>
  <p class="text-muted mb-0">Masukkan email yang digunakan saat memesan untuk melihat daftar tiket Anda.</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/travel/tiket-saya" class="row g-3 align-items-end">
      <div class="col-md-9">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" name="email" placeholder="email@contoh.com"
               value="<%= email || '' %>" required>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Cari Tiket</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-info"><%= error %></div>
<% } %>

<% if (data && data.length > 0) { %>
  <div class="card">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Kode Booking</th>
          <th>Rute</th>
          <th>Tanggal</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(function(item) { %>
          <tr>
            <td><%= item.kode_booking_reference %></td>
            <td><%= item.kota_asal %> &rarr; <%= item.kota_tujuan %></td>
            <td><%= item.tanggal_keberangkatan %></td>
            <td>
              <% if (item.status_booking === 'dibatalkan') { %>
                <span class="badge text-bg-secondary">Dibatalkan</span>
              <% } else if (item.status_booking === 'confirmed') { %>
                <span class="badge text-bg-success">Confirmed</span>
              <% } else { %>
                <span class="badge text-bg-warning">Waiting Payment</span>
              <% } %>
            </td>
            <td>
              <% if (item.status_booking !== 'dibatalkan') { %>
                <form method="POST" action="/travel/batalkan-tiket" onsubmit="return confirm('Yakin ingin membatalkan tiket ini?');">
                  <input type="hidden" name="kodeBooking" value="<%= item.kode_booking_reference %>">
                  <input type="hidden" name="email" value="<%= email %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Batalkan</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../../views/partials/footer') %>
<%- include('../../views/partials/header', { pageTitle: 'Akun Pengunjung' }) %>

<div class="page-header">
  <h1 class="h3">Akun Pengunjung</h1>
  <p class="text-muted mb-0">Tiket yang telah terpesan atas nama pengunjung.</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/travel/akun-pengunjung" class="row g-3 align-items-end">
      <div class="col-md-9">
        <label class="form-label">ID Pengunjung</label>
        <input type="number" class="form-control" name="pengunjungId" placeholder="Contoh: 1" required>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Lihat Tiket</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><%= error %></div>
<% } %>

<% if (pengunjung) { %>
  <h6 class="text-muted">Halo, <%= pengunjung.nama %>!</h6>

  <% if (data && data.length > 0) { %>
    <div class="card">
      <table class="table table-hover mb-0 align-middle">
        <thead>
          <tr><th>Kode Booking</th><th>No. Penerbangan</th><th>Rute</th><th>Tanggal</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% data.forEach(function(item) { %>
            <tr>
              <td><%= item.kode_booking_reference %></td>
              <td><%= item.nomor_penerbangan %></td>
              <td><%= item.kota_asal %> &rarr; <%= item.kota_tujuan %></td>
              <td><%= item.tanggal_keberangkatan %></td>
              <td><span class="badge text-bg-secondary"><%= item.status_booking %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="alert alert-info">Belum ada tiket yang terpesan.</div>
  <% } %>
<% } %>

<%- include('../../views/partials/footer') %>
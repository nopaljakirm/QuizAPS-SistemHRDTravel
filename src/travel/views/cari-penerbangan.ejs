<%- include('../../views/partials/header', { pageTitle: 'Cari Jadwal Penerbangan' }) %>

<div class="page-header">
  <h1 class="h3">Cari Jadwal Penerbangan</h1>
  <p class="text-muted mb-0">Temukan penerbangan sesuai rute yang Anda inginkan.</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/travel/cari-penerbangan" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label">Kota Asal</label>
        <input type="text" class="form-control" name="kotaAsal" placeholder="Contoh: Surabaya"
               value="<%= typeof kotaAsal !== 'undefined' ? kotaAsal : '' %>" required>
      </div>
      <div class="col-md-5">
        <label class="form-label">Kota Tujuan</label>
        <input type="text" class="form-control" name="kotaTujuan" placeholder="Contoh: Jakarta"
               value="<%= typeof kotaTujuan !== 'undefined' ? kotaTujuan : '' %>" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Cari</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><%= error %></div>
<% } %>

<% if (data && data.length > 0) { %>
  <div class="card">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>No. Penerbangan</th>
          <th>Maskapai</th>
          <th>Tanggal</th>
          <th>Jam</th>
          <th>Harga</th>
          <th>Kursi Tersedia</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(function(item) { %>
          <tr>
            <td><%= item.nomor_penerbangan %></td>
            <td><%= item.nama_maskapai %></td>
            <td><%= item.tanggal_keberangkatan %></td>
            <td><%= item.jam_keberangkatan %></td>
            <td>Rp <%= item.harga.toLocaleString('id-ID') %></td>
            <td><%= item.kursi_tersedia %></td>
            <td>
              <% if (item.kursi_tersedia > 0) { %>
                <a href="/travel/pesan-tiket?penerbanganId=<%= item.id %>" class="btn btn-sm btn-success">Pesan</a>
              <% } else { %>
                <span class="badge text-bg-secondary">Penuh</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else if (data) { %>
  <div class="alert alert-info">Tidak ada penerbangan untuk rute ini.</div>
<% } %>

<%- include('../../views/partials/footer') %>
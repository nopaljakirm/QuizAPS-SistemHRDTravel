<%- include('../../views/partials/header', { pageTitle: 'Pencarian Multi-destinasi' }) %>

<div class="page-header">
  <h1 class="h3">Pencarian Penerbangan Multi-destinasi</h1>
  <p class="text-muted mb-0">Masukkan kombinasi kriteria pencarian (boleh isi sebagian saja).</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/travel/multi-destinasi" class="row g-3 align-items-end">
      <div class="col-md-3">
        <label class="form-label">Tanggal</label>
        <input type="date" class="form-control" name="tanggal" value="<%= typeof tanggal !== 'undefined' ? tanggal : '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Kota Asal</label>
        <input type="text" class="form-control" name="kotaAsal" placeholder="Contoh: Jakarta" value="<%= typeof kotaAsal !== 'undefined' ? kotaAsal : '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Kota Tujuan</label>
        <input type="text" class="form-control" name="kotaTujuan" placeholder="Contoh: Bali" value="<%= typeof kotaTujuan !== 'undefined' ? kotaTujuan : '' %>">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Cari</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><%= error %></div>
<% } %>

<% if (data && data.length > 0) { %>
  <div class="card">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>No. Penerbangan</th><th>Maskapai</th><th>Rute</th><th>Tanggal</th><th>Harga</th></tr>
      </thead>
      <tbody>
        <% data.forEach(function(item) { %>
          <tr>
            <td><%= item.nomor_penerbangan %></td>
            <td><%= item.nama_maskapai %></td>
            <td><%= item.kota_asal %> &rarr; <%= item.kota_tujuan %></td>
            <td><%= item.tanggal_keberangkatan %></td>
            <td>Rp <%= item.harga.toLocaleString('id-ID') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else if (data) { %>
  <div class="alert alert-info">Tidak ada penerbangan yang sesuai kriteria.</div>
<% } %>

<%- include('../../views/partials/footer') %>
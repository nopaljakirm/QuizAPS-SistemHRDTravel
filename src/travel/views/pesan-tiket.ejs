<%- include('../../views/partials/header', { pageTitle: 'Pesan Tiket Pesawat' }) %>

<div class="page-header">
  <h1 class="h3">Pesan Tiket Pesawat</h1>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><%= error %></div>
  <a href="/travel/cari-penerbangan" class="btn btn-outline-primary">Kembali ke Pencarian</a>
<% } %>

<% if (penerbangan) { %>
  <div class="row">
    <div class="col-md-5">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title text-muted">Detail Penerbangan</h6>
          <table class="table table-borderless mb-0">
            <tr><th style="width: 140px;">No. Penerbangan</th><td><%= penerbangan.nomor_penerbangan %></td></tr>
            <tr><th>Maskapai</th><td><%= penerbangan.nama_maskapai %></td></tr>
            <tr><th>Rute</th><td><%= penerbangan.kota_asal %> &rarr; <%= penerbangan.kota_tujuan %></td></tr>
            <tr><th>Tanggal</th><td><%= penerbangan.tanggal_keberangkatan %></td></tr>
            <tr><th>Jam</th><td><%= penerbangan.jam_keberangkatan %></td></tr>
            <tr><th>Harga</th><td>Rp <%= penerbangan.harga.toLocaleString('id-ID') %></td></tr>
          </table>
        </div>
      </div>
    </div>

    <div class="col-md-7">
      <div class="card">
        <div class="card-body">
          <h6 class="card-title text-muted">Data Penumpang</h6>
          <form method="POST" action="/travel/pesan-tiket">
            <input type="hidden" name="penerbanganId" value="<%= penerbangan.id %>">
            <div class="mb-3">
              <label class="form-label">Nama Lengkap</label>
              <input type="text" class="form-control" name="namaPenumpang" placeholder="Nama sesuai identitas" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="emailPenumpang" placeholder="email@contoh.com" required>
              <div class="form-text">Digunakan untuk melihat kembali tiket Anda nanti.</div>
            </div>
            <button type="submit" class="btn btn-success">Konfirmasi Pemesanan</button>
          </form>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (konfirmasi) { %>
  <div class="alert alert-success">
    <h5 class="alert-heading">Pemesanan Berhasil</h5>
    <p class="mb-1"><strong>Nama Penumpang:</strong> <%= konfirmasi.namaPenumpang %></p>
    <p class="mb-1"><strong>Kode Booking:</strong> <span class="fw-bold"><%= konfirmasi.kode_booking_reference %></span></p>
    <p class="mb-1"><strong>Rute:</strong> <%= konfirmasi.penerbangan.kota_asal %> &rarr; <%= konfirmasi.penerbangan.kota_tujuan %></p>
    <p class="mb-0"><strong>Status:</strong> <%= konfirmasi.status_booking %></p>
  </div>
  <a href="/travel/tiket-saya?email=<%= konfirmasi.email_penumpang || '' %>" class="btn btn-outline-primary">Lihat Tiket Saya</a>
<% } %>

<%- include('../../views/partials/footer') %>
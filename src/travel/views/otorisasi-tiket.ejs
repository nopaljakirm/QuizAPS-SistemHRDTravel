<%- include('../../views/partials/header', { pageTitle: 'Otorisasi Tiket' }) %>

<div class="page-header">
  <h1 class="h3">Otorisasi Tiket</h1>
  <p class="text-muted mb-0">Periksa status booking melalui kode booking reference.</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="POST" action="/travel/otorisasi-tiket" class="row g-3 align-items-end">
      <div class="col-md-9">
        <label class="form-label">Kode Booking</label>
        <input type="text" class="form-control" name="kodeBooking" placeholder="Contoh: BR123456" required>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Otorisasi</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (hasil) { %>
  <div class="alert alert-success">
    <h6 class="alert-heading">Status Booking Ditemukan</h6>
    <p class="mb-1"><strong>Kode Booking:</strong> <%= hasil.kode_booking_reference %></p>
    <p class="mb-0"><strong>Status:</strong> <span class="badge text-bg-secondary"><%= hasil.status_booking %></span></p>
  </div>
<% } %>

<%- include('../../views/partials/footer') %>
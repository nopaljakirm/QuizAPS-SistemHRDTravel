<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Otorisasi Tiket</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; }
    label { display: inline-block; width: 150px; }
    input, button { padding: 8px; margin: 5px 0; }
    .error { color: #e74c3c; }
    .success-box { background: #d4edda; padding: 20px; border-radius: 8px; margin-top: 20px; }
    a { color: #2980b9; }
  </style>
</head>
<body>
  <a href="/">&larr; Kembali ke Menu</a>
  <h1>UC12: Melakukan Otorisasi Tiket</h1>

  <form method="POST" action="/otorisasi-tiket">
    <label>Kode Booking:</label>
    <input type="text" name="kodeBooking" placeholder="Contoh: BR123456" required>
    <button type="submit">Otorisasi</button>
  </form>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (hasil) { %>
    <div class="success-box">
      <h3>✅ Status Booking Ditemukan</h3>
      <p><strong>Kode Booking:</strong> <%= hasil.kode_booking_reference %></p>
      <p><strong>Status:</strong> <%= hasil.status_booking %></p>
    </div>
  <% } %>
</body>
</html>
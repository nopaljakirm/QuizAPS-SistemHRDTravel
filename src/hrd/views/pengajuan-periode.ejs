<%- include('../../views/partials/header', { pageTitle: 'Pengajuan Cuti per Periode' }) %>

<div class="page-header">
  <h1 class="h3">Pengajuan Cuti per Periode</h1>
  <p class="text-muted mb-0">Lihat daftar pegawai yang mengajukan cuti pada rentang tanggal tertentu.</p>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/hrd/pengajuan-periode" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Periode Mulai</label>
        <input type="date" class="form-control" name="periodeMulai"
               value="<%= typeof periodeMulai !== 'undefined' ? periodeMulai : '' %>" required>
      </div>
      <div class="col-md-4">
        <label class="form-label">Periode Selesai</label>
        <input type="date" class="form-control" name="periodeSelesai"
               value="<%= typeof periodeSelesai !== 'undefined' ? periodeSelesai : '' %>" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Cari</button>
      </div>
    </form>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-warning"><%= error %></div>
<% } %>

<% if (data && data.length > 0) { %>
  <div class="card">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>Nama Pegawai</th>
          <th>Departemen</th>
          <th>Periode</th>
          <th>Lama Cuti</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% data.forEach(function(item) { %>
          <tr>
            <td><%= item.nama %></td>
            <td><%= item.departemen %></td>
            <td><%= item.periode_mulai %> s/d <%= item.periode_selesai %></td>
            <td><%= item.lama_waktu_cuti %> hari</td>
            <td>
              <% if (item.status === 'disetujui') { %>
                <span class="badge text-bg-success">Disetujui</span>
              <% } else if (item.status === 'pending') { %>
                <span class="badge text-bg-warning">Pending</span>
              <% } else { %>
                <span class="badge text-bg-secondary"><%= item.status %></span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } else if (data) { %>
  <div class="alert alert-info">Tidak ada data pengajuan cuti pada periode ini.</div>
<% } %>

<%- include('../../views/partials/footer') %>
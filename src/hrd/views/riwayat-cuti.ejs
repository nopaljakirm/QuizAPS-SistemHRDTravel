<%- include('../../views/partials/header', { pageTitle: 'Riwayat Cuti Pegawai' }) %>

<div class="page-header">
  <h1 class="h3">Riwayat &amp; Sisa Cuti Pegawai</h1>
  <p class="text-muted mb-0">Tahun berjalan: <%= tahunBerjalan %></p>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/hrd/riwayat-cuti" class="row g-3 align-items-end">
      <div class="col-md-8">
        <label class="form-label">Pilih Pegawai</label>
        <select name="nipPegawai" class="form-select" required>
          <option value="" disabled selected>-- Pilih nama pegawai --</option>
          <% daftarPegawai.forEach(function(p) { %>
            <option value="<%= p.nip %>" <%= (pegawai && pegawai.nip === p.nip) ? 'selected' : '' %>>
              <%= p.nama %> &mdash; <%= p.departemen %>
            </option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100">Lihat Riwayat</button>
      </div>
    </form>
  </div>
</div>

<% if (pegawai && riwayat) { %>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title"><%= pegawai.nama %></h5>
      <p class="text-muted"><%= pegawai.departemen %></p>
      <table class="table">
        <tbody>
          <tr>
            <th scope="row" style="width: 200px;">Sisa Waktu Cuti</th>
            <td><%= riwayat.sisa_waktu_cuti %> hari</td>
          </tr>
          <tr>
            <th scope="row">Total Cuti Terpakai</th>
            <td><%= riwayat.total_cuti_terpakai %> hari</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% } else if (pegawai && !riwayat) { %>
  <div class="alert alert-info">Riwayat cuti untuk tahun ini belum tersedia pada pegawai tersebut.</div>
<% } %>

<%- include('../../views/partials/footer') %>
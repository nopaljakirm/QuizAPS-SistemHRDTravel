<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Pesan Tiket Pesawat</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; }
    label { display: inline-block; width: 150px; }
    input, button { padding: 8px; margin: 5px 0; }
    .error { color: #e74c3c; }
    .success-box { background: #d4edda; padding: 20px; border-radius: 8px; margin-top: 20px; }
    a { color: #2980b9; }
  </style>
</head>
<body>
  <a href="/">&larr; Kembali ke Menu</a>
  <h1>UC2: Memesan Tiket Pesawat</h1>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (!konfirmasi) { %>
    <form method="POST" action="/pesan-tiket">
      <div>
        <label>ID Penerbangan:</label>
        <input type="number" name="penerbanganId" placeholder="Contoh: 1" required>
      </div>
      <div>
        <label>Nama Penumpang:</label>
        <input type="text" name="namaPenumpang" placeholder="Nama Anda" required>
      </div>
      <button type="submit">Pesan Tiket</button>
    </form>
    <p><em>Tips: coba ID Penerbangan 1 atau 2 (rute Surabaya-Jakarta)</em></p>
  <% } %>

  <% if (konfirmasi) { %>
    <div class="success-box">
      <h3>✅ Pemesanan Berhasil!</h3>
      <p><strong>Nama Penumpang:</strong> <%= konfirmasi.namaPenumpang %></p>
      <p><strong>Kode Booking:</strong> <%= konfirmasi.kode_booking_reference %></p>
      <p><strong>Status:</strong> <%= konfirmasi.status_booking %></p>
    </div>
  <% } %>
</body>
</html>